{
  "name": "PlannerGoal",
  "type": "object",
  "properties": {
    "title": {
      "type": "string",
      "title": "Goal"
    },
    "category": {
      "type": "string",
      "enum": [
        "followers",
        "subs",
        "revenue",
        "content",
        "other"
      ],
      "default": "other",
      "title": "Category"
    },
    "target": {
      "type": "number",
      "title": "Target"
    },
    "current": {
      "type": "number",
      "default": 0,
      "title": "Current"
    },
    "deadline": {
      "type": "string",
      "format": "date",
      "title": "Deadline"
    },
    "completed": {
      "type": "boolean",
      "default": false,
      "title": "Completed"
    }
  },
  "required": [
    "title",
    "target"
  ],
  "rls": {
    "create": {
      "created_by_id": "{{user.id}}"
    },
    "read": {
      "$or": [
        {
          "created_by_id": "{{user.id}}"
        },
        {
          "user_condition": {
            "role": "admin"
          }
        }
      ]
    },
    "update": {
      "$or": [
        {
          "created_by_id": "{{user.id}}"
        },
        {
          "user_condition": {
            "role": "admin"
          }
        }
      ]
    },
    "delete": {
      "$or": [
        {
          "created_by_id": "{{user.id}}"
        },
        {
          "user_condition": {
            "role": "admin"
          }
        }
      ]
    }
  }
}