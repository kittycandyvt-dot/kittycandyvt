{
  "name": "CommissionTracker",
  "type": "object",
  "properties": {
    "commissionNumber": {
      "type": "string",
      "title": "Commission #"
    },
    "client": {
      "type": "string",
      "title": "Client"
    },
    "project": {
      "type": "string",
      "title": "Project"
    },
    "projectType": {
      "type": "string",
      "title": "Type"
    },
    "contentRating": {
      "type": "string",
      "enum": [
        "SFW",
        "NSFW"
      ],
      "default": "SFW",
      "title": "SFW / NSFW"
    },
    "scriptReceived": {
      "type": "boolean",
      "default": false,
      "title": "Script Received"
    },
    "wordCount": {
      "type": "number",
      "default": 0,
      "title": "Word Count"
    },
    "price": {
      "type": "number",
      "default": 0,
      "title": "Price"
    },
    "deposit": {
      "type": "number",
      "default": 0,
      "title": "Deposit"
    },
    "deadline": {
      "type": "string",
      "format": "date",
      "title": "Deadline"
    },
    "recording": {
      "type": "string",
      "enum": [
        "not_started",
        "in_progress",
        "done"
      ],
      "default": "not_started",
      "title": "Recording"
    },
    "editing": {
      "type": "string",
      "enum": [
        "not_started",
        "in_progress",
        "done"
      ],
      "default": "not_started",
      "title": "Editing"
    },
    "revisions": {
      "type": "number",
      "default": 0,
      "title": "Revisions"
    },
    "delivery": {
      "type": "string",
      "enum": [
        "pending",
        "delivered"
      ],
      "default": "pending",
      "title": "Delivery"
    },
    "paymentReceived": {
      "type": "boolean",
      "default": false,
      "title": "Payment Received"
    },
    "testimonialRequested": {
      "type": "boolean",
      "default": false,
      "title": "Testimonial Requested"
    },
    "notes": {
      "type": "string",
      "title": "Notes"
    }
  },
  "required": [
    "client",
    "project"
  ],
  "rls": {
    "read": {
      "$or": [
        {
          "created_by_id": "{{user.id}}"
        },
        {
          "user_condition": {
            "role": "admin"
          }
        }
      ]
    },
    "create": {
      "created_by_id": "{{user.id}}"
    },
    "update": {
      "$or": [
        {
          "created_by_id": "{{user.id}}"
        },
        {
          "user_condition": {
            "role": "admin"
          }
        }
      ]
    },
    "delete": {
      "$or": [
        {
          "created_by_id": "{{user.id}}"
        },
        {
          "user_condition": {
            "role": "admin"
          }
        }
      ]
    }
  }
}