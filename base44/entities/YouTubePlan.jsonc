{
  "name": "YouTubePlan",
  "type": "object",
  "properties": {
    "videoIdea": {
      "type": "string",
      "title": "Video Idea"
    },
    "format": {
      "type": "string",
      "enum": [
        "long",
        "short"
      ],
      "default": "long",
      "title": "Format"
    },
    "recordingDate": {
      "type": "string",
      "format": "date",
      "title": "Recording Date"
    },
    "editingStatus": {
      "type": "string",
      "enum": [
        "not_started",
        "in_progress",
        "done"
      ],
      "default": "not_started",
      "title": "Editing Status"
    },
    "thumbnail": {
      "type": "string",
      "title": "Thumbnail"
    },
    "title": {
      "type": "string",
      "title": "Title"
    },
    "description": {
      "type": "string",
      "title": "Description"
    },
    "uploadDate": {
      "type": "string",
      "format": "date",
      "title": "Upload Date"
    },
    "notes": {
      "type": "string",
      "title": "Notes"
    }
  },
  "required": [
    "videoIdea"
  ],
  "rls": {
    "read": {
      "$or": [
        {
          "created_by_id": "{{user.id}}"
        },
        {
          "user_condition": {
            "role": "admin"
          }
        }
      ]
    },
    "create": {
      "created_by_id": "{{user.id}}"
    },
    "update": {
      "$or": [
        {
          "created_by_id": "{{user.id}}"
        },
        {
          "user_condition": {
            "role": "admin"
          }
        }
      ]
    },
    "delete": {
      "$or": [
        {
          "created_by_id": "{{user.id}}"
        },
        {
          "user_condition": {
            "role": "admin"
          }
        }
      ]
    }
  }
}