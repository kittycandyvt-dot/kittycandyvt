{
  "name": "PlannerStream",
  "type": "object",
  "properties": {
    "title": {
      "type": "string",
      "title": "Title",
      "description": "Stream title"
    },
    "streamDate": {
      "type": "string",
      "format": "date-time",
      "title": "Stream Date & Time"
    },
    "platform": {
      "type": "string",
      "title": "Platform",
      "description": "Twitch, YouTube, etc."
    },
    "status": {
      "type": "string",
      "enum": [
        "planned",
        "live",
        "completed",
        "cancelled"
      ],
      "default": "planned",
      "title": "Status"
    },
    "notes": {
      "type": "string",
      "title": "Notes"
    }
  },
  "required": [
    "title",
    "streamDate"
  ],
  "rls": {
    "create": {
      "created_by_id": "{{user.id}}"
    },
    "read": {
      "$or": [
        {
          "created_by_id": "{{user.id}}"
        },
        {
          "user_condition": {
            "role": "admin"
          }
        }
      ]
    },
    "update": {
      "$or": [
        {
          "created_by_id": "{{user.id}}"
        },
        {
          "user_condition": {
            "role": "admin"
          }
        }
      ]
    },
    "delete": {
      "$or": [
        {
          "created_by_id": "{{user.id}}"
        },
        {
          "user_condition": {
            "role": "admin"
          }
        }
      ]
    }
  }
}