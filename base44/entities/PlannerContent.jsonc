{
  "name": "PlannerContent",
  "type": "object",
  "properties": {
    "title": {
      "type": "string",
      "title": "Title"
    },
    "contentType": {
      "type": "string",
      "enum": [
        "video",
        "short",
        "stream",
        "social",
        "other"
      ],
      "default": "video",
      "title": "Content Type"
    },
    "status": {
      "type": "string",
      "enum": [
        "idea",
        "scripting",
        "recording",
        "editing",
        "scheduled",
        "published"
      ],
      "default": "idea",
      "title": "Status"
    },
    "scheduledDate": {
      "type": "string",
      "format": "date",
      "title": "Scheduled Date"
    },
    "notes": {
      "type": "string",
      "title": "Notes"
    }
  },
  "required": [
    "title"
  ],
  "rls": {
    "create": {
      "created_by_id": "{{user.id}}"
    },
    "read": {
      "$or": [
        {
          "created_by_id": "{{user.id}}"
        },
        {
          "user_condition": {
            "role": "admin"
          }
        }
      ]
    },
    "update": {
      "$or": [
        {
          "created_by_id": "{{user.id}}"
        },
        {
          "user_condition": {
            "role": "admin"
          }
        }
      ]
    },
    "delete": {
      "$or": [
        {
          "created_by_id": "{{user.id}}"
        },
        {
          "user_condition": {
            "role": "admin"
          }
        }
      ]
    }
  }
}