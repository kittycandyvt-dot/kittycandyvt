{
  "name": "PlannerEvent",
  "type": "object",
  "properties": {
    "title": {
      "type": "string",
      "title": "Title"
    },
    "type": {
      "type": "string",
      "enum": [
        "event",
        "stream",
        "upload",
        "content",
        "goal",
        "important"
      ],
      "default": "event",
      "title": "Type"
    },
    "date": {
      "type": "string",
      "format": "date-time",
      "title": "Date & Time"
    },
    "endDate": {
      "type": "string",
      "format": "date-time",
      "title": "End Date & Time"
    },
    "notes": {
      "type": "string",
      "title": "Notes"
    },
    "priority": {
      "type": "string",
      "enum": [
        "low",
        "medium",
        "high"
      ],
      "default": "medium",
      "title": "Priority"
    }
  },
  "required": [
    "title",
    "date"
  ],
  "rls": {
    "read": {
      "$or": [
        {
          "$and": [
            {
              "created_by_id": "{{user.id}}"
            },
            {
              "user_condition": {
                "role": "planner"
              }
            }
          ]
        },
        {
          "user_condition": {
            "role": "admin"
          }
        }
      ]
    },
    "create": {
      "$and": [
        {
          "created_by_id": "{{user.id}}"
        },
        {
          "$or": [
            {
              "user_condition": {
                "role": "planner"
              }
            },
            {
              "user_condition": {
                "role": "admin"
              }
            }
          ]
        }
      ]
    },
    "update": {
      "$or": [
        {
          "$and": [
            {
              "created_by_id": "{{user.id}}"
            },
            {
              "user_condition": {
                "role": "planner"
              }
            }
          ]
        },
        {
          "user_condition": {
            "role": "admin"
          }
        }
      ]
    },
    "delete": {
      "$or": [
        {
          "$and": [
            {
              "created_by_id": "{{user.id}}"
            },
            {
              "user_condition": {
                "role": "planner"
              }
            }
          ]
        },
        {
          "user_condition": {
            "role": "admin"
          }
        }
      ]
    }
  }
}