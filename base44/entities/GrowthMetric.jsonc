{
  "name": "GrowthMetric",
  "type": "object",
  "properties": {
    "platform": {
      "type": "string",
      "title": "Platform"
    },
    "metric": {
      "type": "string",
      "title": "Metric"
    },
    "currentValue": {
      "type": "number",
      "default": 0,
      "title": "Current Value"
    },
    "previousValue": {
      "type": "number",
      "default": 0,
      "title": "Previous Value"
    },
    "goal": {
      "type": "number",
      "title": "Goal"
    },
    "targetDate": {
      "type": "string",
      "format": "date",
      "title": "Target Date"
    },
    "notes": {
      "type": "string",
      "title": "Notes"
    }
  },
  "required": [
    "platform",
    "metric"
  ],
  "rls": {
    "read": {
      "$or": [
        {
          "$and": [
            {
              "created_by_id": "{{user.id}}"
            },
            {
              "user_condition": {
                "role": "planner"
              }
            }
          ]
        },
        {
          "user_condition": {
            "role": "admin"
          }
        }
      ]
    },
    "create": {
      "$and": [
        {
          "created_by_id": "{{user.id}}"
        },
        {
          "$or": [
            {
              "user_condition": {
                "role": "planner"
              }
            },
            {
              "user_condition": {
                "role": "admin"
              }
            }
          ]
        }
      ]
    },
    "update": {
      "$or": [
        {
          "$and": [
            {
              "created_by_id": "{{user.id}}"
            },
            {
              "user_condition": {
                "role": "planner"
              }
            }
          ]
        },
        {
          "user_condition": {
            "role": "admin"
          }
        }
      ]
    },
    "delete": {
      "$or": [
        {
          "$and": [
            {
              "created_by_id": "{{user.id}}"
            },
            {
              "user_condition": {
                "role": "planner"
              }
            }
          ]
        },
        {
          "user_condition": {
            "role": "admin"
          }
        }
      ]
    }
  }
}