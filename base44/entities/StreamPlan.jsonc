{
  "name": "StreamPlan",
  "type": "object",
  "properties": {
    "title": {
      "type": "string",
      "title": "Stream Title"
    },
    "streamConcept": {
      "type": "string",
      "title": "Stream Concept"
    },
    "titleIdeas": {
      "type": "string",
      "title": "Title Ideas"
    },
    "game": {
      "type": "string",
      "title": "Game / Category"
    },
    "date": {
      "type": "string",
      "format": "date",
      "title": "Date"
    },
    "startTime": {
      "type": "string",
      "title": "Start Time"
    },
    "endTime": {
      "type": "string",
      "title": "Expected End Time"
    },
    "platform": {
      "type": "string",
      "title": "Platform"
    },
    "goal": {
      "type": "string",
      "title": "Stream Goals"
    },
    "talkingPoints": {
      "type": "string",
      "title": "Talking Points"
    },
    "segments": {
      "type": "string",
      "title": "Bits / Segments"
    },
    "chatIdeas": {
      "type": "string",
      "title": "Chat Questions"
    },
    "giveaways": {
      "type": "string",
      "title": "Giveaways"
    },
    "collabGuests": {
      "type": "string",
      "title": "Collab Guests"
    },
    "assetsNeeded": {
      "type": "string",
      "title": "Assets Needed"
    },
    "playlist": {
      "type": "string",
      "title": "Playlist"
    },
    "streamAnnouncements": {
      "type": "string",
      "title": "Stream Announcements"
    },
    "potentialClips": {
      "type": "string",
      "title": "Potential Clip Moments"
    },
    "alerts": {
      "type": "string",
      "title": "Alerts"
    },
    "notes": {
      "type": "string",
      "title": "Notes"
    },
    "checklist": {
      "type": "array",
      "items": {
        "type": "object",
        "properties": {
          "label": {
            "type": "string"
          },
          "done": {
            "type": "boolean"
          }
        }
      },
      "title": "Pre-Stream Checklist"
    }
  },
  "required": [
    "title"
  ],
  "rls": {
    "read": {
      "$or": [
        {
          "created_by_id": "{{user.id}}"
        },
        {
          "user_condition": {
            "role": "admin"
          }
        }
      ]
    },
    "create": {
      "created_by_id": "{{user.id}}"
    },
    "update": {
      "$or": [
        {
          "created_by_id": "{{user.id}}"
        },
        {
          "user_condition": {
            "role": "admin"
          }
        }
      ]
    },
    "delete": {
      "$or": [
        {
          "created_by_id": "{{user.id}}"
        },
        {
          "user_condition": {
            "role": "admin"
          }
        }
      ]
    }
  }
}